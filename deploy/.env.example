# 复制为 .env 并修改后再 docker compose up（切勿把真实 .env 提交仓库）
# 镜像版本（S1 固定可复现；本机已有其他 tag 时可按需覆盖）
# QDRANT_TAG=v1.12.4
MYSQL_DB=dianfei
MYSQL_USER=dianfei
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
REDIS_PASSWORD=change-me-redis-password
JWT_SECRET=change-me-to-a-64-char-random-string
DIANFEI_FIELD_KEY=change-me-to-16-24-or-32-byte-key
# 邮箱验证码（V39）：网易 163 SMTP 授权码（邮箱设置→POP3/SMTP 开启后生成），非登录密码
MAIL_PASSWORD=change-me-163-smtp-auth-code
# 发件邮箱（生产替换为实际发件账号）
MAIL_USERNAME=noreply@example.com
DIANFEI_CORS_ALLOWED_ORIGINS=https://your-production-domain.example
# 文件存储：默认 local（容器卷 back-upload）；改为 oss 时启用阿里云 OSS 对象存储并配置以下键
DIANFEI_FILE_STORAGE_TYPE=local
DIANFEI_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
DIANFEI_OSS_ACCESS_KEY_ID=change-me-access-key-id
DIANFEI_OSS_ACCESS_KEY_SECRET=change-me-access-key-secret
DIANFEI_OSS_BUCKET=waste-turns-to-gold
AI_INTERNAL_TOKEN=change-me-internal-token
# 供应商密钥列 AES 密钥（16/24/32 字节），与 AI_INTERNAL_TOKEN 相同或独立；生产必配
DIANFEI_AI_CONFIG_AES_KEY=change-me-aes-key-32-characters-long
# C14：容器内链路地址由 compose 固定注入（DIANFEI_AI_BASE_URL=http://ai-service:8100、
# AI_CONFIG_API_URL=http://back:8080/api/ai/config/runtime），一般无需在 .env 覆盖
# Nginx 反代上游：全容器环境用默认 http://back:8080；联调期后端跑宿主机时改为 http://host.docker.internal:8080
BACKEND_UPSTREAM=http://back:8080
