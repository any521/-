# 点废成金 v2.0 Nginx 反代（A5）：三端静态 + /api 反代后端；AI 服务仅内网不在此暴露
# envsubst 模板（nginx 官方镜像 /etc/nginx/templates 机制）：仅 ${BACKEND_UPSTREAM} 会被替换，
#   默认 http://back:8080（容器网络）；联调期后端跑宿主机时设 BACKEND_UPSTREAM=http://host.docker.internal:8080
# HTTPS：生产在 443 server 块挂证书后 301 跳转，此处提供 80 基础配置

# WebSocket 升级头（大屏/通知推送预留）
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_min_length 1k;
    client_max_body_size 500m;   # IM 视频上限 500MB（与后端 multipart max-request-size 对齐）

    # S1 基础安全响应头（CSP 涉及第三方脚本/地图/WASM 易误伤，按需另行评估）
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # ---------- 后端 API ----------
    # 用 Docker 内置 DNS + 变量延迟解析：上游未启动时 Nginx 仍可正常拉起（静态三端可独立验证）
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend ${BACKEND_UPSTREAM};

    location /api/ {
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 60s;
    }

    # IM WebSocket 长连接（onsite03）：升级头 + 长超时；其余同 /api/ 反代
    location /api/ws/ {
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # 接口文档（生产可按需关闭）
    location ~ ^/(doc\.html|webjars/|v3/api-docs) {
        proxy_pass $backend;
        proxy_set_header Host $host;
    }

    # ---------- 管理后台（front/dist） ----------
    location /admin/ {
        alias /usr/share/nginx/html/admin/;
        try_files $uri $uri/ /admin/index.html;
    }

    # ---------- 员工端（front-staff/dist） ----------
    location /staff/ {
        alias /usr/share/nginx/html/staff/;
        try_files $uri $uri/ /staff/index.html;
    }

    # ---------- 用户端 H5（front-user/dist，默认根路径） ----------
    location / {
        # 卡顿修复 B：仅用户端开跨域隔离（端侧 AR 推理 WASM 多线程需要），
        # credentialless 保证跨域图片（MinIO 等）无需 CORS 头仍可匿名加载
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header Cross-Origin-Embedder-Policy credentialless always;
        root /usr/share/nginx/html/user;
        try_files $uri $uri/ /index.html;
    }
}
