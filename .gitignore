# ---- 依赖与构建产物 ----
node_modules/
dist/
target/
*.tsbuildinfo
.npm-cache/
npm-cache/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# ---- 运行时数据 ----
**/upload/
back/logs/
back/tmp-check/
*.log
hs_err_pid*.log
replay_pid*.log
