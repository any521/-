# 点废成金 AI 服务环境变量示例
# 复制为 .env 并修改后使用

# 运行环境（prod 时强制校验 INTERNAL_TOKEN）
AI_ENV=dev

# 内网服务间鉴权 Token（生产必配，>= 32 字符）
AI_INTERNAL_TOKEN=

# AI 配置目录与 API 地址
AI_CONFIG_DIR=
AI_CONFIG_API_URL=http://127.0.0.1:8080/api/ai/config/runtime

# LLM 供应商 API Key
DEEPSEEK_API_KEY=
ARK_API_KEY=

# Web 搜索
AI_WEBSEARCH_PROVIDER=bocha
BOCHA_API_KEY=
TAVILY_API_KEY=

# Qdrant 向量库
QDRANT_URL=http://127.0.0.1:6333
